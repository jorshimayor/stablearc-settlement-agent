# ── StableArc Settlement Agent — environment ────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it's gitignored).
# Keep values on their own line with no trailing "# comment" after them.

# ── Language model (model-agnostic) ─────────────────────────────────────────
# Any OpenAI-compatible endpoint works: Cencori (the hackathon AI partner),
# OpenAI, Groq, OpenRouter, Together, a local Ollama, etc. Or native Anthropic.
# LLM_PROVIDER: openai | anthropic  (leave blank to auto-detect from the keys)
LLM_PROVIDER=openai
# LLM_BASE_URL: an OpenAI-compatible base URL (ignored for the anthropic provider)
LLM_BASE_URL=https://api.cencori.com/v1
# LLM_API_KEY: key for the chosen provider
LLM_API_KEY=
# LLM_MODEL: model id. MUST support tool/function calling. On Cencori,
# mistral-small-latest, gpt-4.1-mini, and gpt-4o-mini work; Google/Gemini does not.
LLM_MODEL=mistral-small-latest

# ── The settlement agent's on-chain key ─────────────────────────────────────
# Server-only. Holds test CELO for gas and acts as the demo maker/solver.
# Use a throwaway testnet key; never a key with real funds.
CELO_AGENT_PK=

# ── Celo network + deployed contracts (from `forge script … Deploy`) ────────
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_INTENT_MATCHER=
NEXT_PUBLIC_CELO_REALIZED_ORACLE=
NEXT_PUBLIC_CELO_TOKEN_NGN=
NEXT_PUBLIC_CELO_TOKEN_GHS=
NEXT_PUBLIC_CELO_TOKEN_KES=

# ── Attribution tag (ERC-8021) — REQUIRED to be counted on the leaderboard ──
# From Celo Builders registration (celo_…). Appended to the calldata of every
# agent transaction and CANNOT be backfilled — set it before the first action.
NEXT_PUBLIC_CELO_ATTRIBUTION_TAG=
# Optionally keep your own tag too (both are appended; only the assigned one is credited).
NEXT_PUBLIC_CELO_OWN_TAG=

# ── Telegram distribution (optional; for the bot adapter) ───────────────────
# Get one from @BotFather.
TELEGRAM_BOT_TOKEN=
